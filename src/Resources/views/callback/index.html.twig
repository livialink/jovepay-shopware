        <script>

      function CheckStatus() {
         
        // Sending and receiving data in JSON format using POST method
        var xhr = new XMLHttpRequest();
        var url = "{{ path('frontend.checkout.jovepay.process.check') }}";
        xhr.open("POST", url, true);
        xhr.setRequestHeader("Content-Type", "application/json");
        xhr.onreadystatechange = function () {
          if (xhr.readyState === 4 && xhr.status === 200) {
           
            var ps1 = JSON.parse(xhr.responseText).payment_status;
            var ps2 = JSON.parse(data).paymentStatus;
            if(ps1!=ps2){
          console.log('Status_changed');
          window.location.reload();
          }
          }
        };
        var data = JSON.stringify({"_sw_order": "{{ _sw_order }}", "paymentStatus": "{{ paymentStatus }}"});
        //console.log(data._sw_order + ", " + data.paymentStatus);
        xhr.send(data);
      }

      window.onload = function () {
        setInterval(function() { 
                CheckStatus()
            }, 3000);
     
      }
    </script>
