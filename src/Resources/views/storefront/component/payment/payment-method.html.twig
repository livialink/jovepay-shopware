{% sw_extends '@Storefront/storefront/component/payment/payment-method.html.twig' %}

{% set isJovepayPayment = payment.handlerIdentifier is same as('JovepayPlugin\\Service\\Jovepay') %}

{% block component_payment_method_image %}
    {% if not isJovepayPayment %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_payment_method_name %}
    {% if isJovepayPayment %}
        {% set jovepayAssetBase = 'bundles/jovepayplugin' %}
        {% set jovepayCoins = [
            { id: 'btc', file: 'btc.png', alt: 'Bitcoin' },
            { id: 'eth', file: 'eth.png', alt: 'Ethereum' },
            { id: 'usdt', file: 'usdt.png', alt: 'Tether' },
            { id: 'bnb', file: 'bnb.png', alt: 'BNB' }
        ] %}

        <span class="jovepay-payment-method-label">
            <img
                class="jovepay-payment-icons__logo"
                src="{{ asset(jovepayAssetBase ~ '/jovepay-logo.svg') }}"
                alt="JOVEpay"
                width="28"
                height="28"
            >
            <strong class="jovepay-payment-method-label__text">{{ paymentName }}</strong>
            <span class="jovepay-payment-icons" aria-hidden="true">
                <span class="jovepay-payment-icons__stack">
                    {% for coin in jovepayCoins %}
                        <img
                            class="jovepay-payment-icons__coin"
                            src="{{ asset(jovepayAssetBase ~ '/' ~ coin.file) }}"
                            alt="{{ coin.alt }}"
                            width="24"
                            height="24"
                        >
                    {% endfor %}
                </span>
            </span>
        </span>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
