<?xml version="1.0" encoding="UTF-8" ?>
<routes xmlns="http://symfony.com/schema/routing"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/routing
        https://symfony.com/schema/routing/routing-1.0.xsd">

    <!--
      Import controller annotations so Shopware 6.4 attaches a RouteScope object
      (with getScopes()) to the request. Do not set _routeScope as a string/array
      default in XML — that crashes RouteScopeCheckTrait on 6.4.0–6.4.14.
    -->
    <import resource="../../Storefront/Controller/*Controller.php" type="annotation" />
</routes>
