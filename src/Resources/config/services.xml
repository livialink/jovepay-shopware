<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Payment Handler Service -->
        <service id="JovepayPlugin\Service\Jovepay">
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="router.default"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="JovepayPlugin\Util\DebugLog" />
            <!-- Single tag used by Shopware 6.6.5+ / 6.7; older releases still accept it -->
            <tag name="shopware.payment.method" />
            <!-- Legacy async tag for Shopware &lt; 6.6.5 -->
            <tag name="shopware.payment.method.async" />
        </service>

        <!-- Controller Service -->
        <service id="JovepayPlugin\Storefront\Controller\CallbackController" public="true">
            <argument type="service" id="JovepayPlugin\Util\DebugLog" />
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <tag name="controller.service_arguments" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Utility Service -->
        <service id="JovepayPlugin\Util\DebugLog" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
        </service>
    </services>
</container>
